---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const writeups = await getCollection('writeups');
  return writeups.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---

<Base title={`${d.title} — Antonio Caserta`} description={d.subtitle} ogImage={`/og/${entry.id}.png`}>
  <main class="wrap writeup">
    <a class="back" href="/#writeups">← back</a>

    <header class={`wh accent-${d.accent}`}>
      <div class="wh-meta">
        <span class="wh-status">{d.status}</span>
        <span class="wh-dot">·</span>
        <span>{d.date}</span>
      </div>
      <h1>{d.title}</h1>
      <p class="wh-sub">{d.subtitle}</p>
      <ul class="wh-stack">
        {d.stack.map((s) => <li>{s}</li>)}
      </ul>
      <div class="wh-links">
        {d.live && <a href={d.live}>live ↗</a>}
        {d.repo && <a href={d.repo}>source ↗</a>}
      </div>
    </header>

    {d.fullSource && (
      <aside class={`fullsource accent-${d.accent}`}>
        <span class="fs-label">full version</span>
        <a href={d.fullSource.url}>Read {d.fullSource.label} ↗</a>
      </aside>
    )}

    <article class="doc">
      <Content />
    </article>

    <footer class="wfoot">
      <a href="/#writeups">← back to writeups</a>
      <a href="/">home</a>
    </footer>
  </main>

  <footer class="statusline">
    <div class="wrap statusline-inner">
      <span class="st-mode">NORMAL</span>
      <span class="st-file">~/caserta/writeups/{entry.id}.md</span>
      <span class="st-spacer"></span>
      <span class="st-git"> main</span>
      <span class="st-pos">utf-8</span>
    </div>
  </footer>

  <style>
    .writeup { padding-block: clamp(2rem, 6vh, 3.5rem) 0; max-width: 820px; }
    .back {
      font-family: var(--mono);
      font-size: 0.78rem;
      color: var(--muted);
      display: inline-block;
      margin-bottom: 2.5rem;
    }
    .back:hover { color: var(--mint); text-decoration: none; }

    .wh { padding-bottom: 2rem; border-bottom: 1px solid var(--line); margin-bottom: 2.5rem; }
    .accent-mint   { --pc: var(--mint); }
    .accent-blue   { --pc: var(--blue); }
    .accent-orange { --pc: var(--orange); }
    .accent-teal   { --pc: var(--teal); }
    .accent-red    { --pc: var(--red); }
    .accent-purple { --pc: var(--purple); }

    .wh-meta { font-family: var(--mono); font-size: 0.74rem; color: var(--muted); display: flex; gap: 0.6rem; margin-bottom: 1rem; }
    .wh-status { color: var(--pc); }
    .wh-dot { color: var(--gutter); }
    .wh h1 {
      font-size: clamp(1.9rem, 5vw, 2.9rem);
      line-height: 1.1;
      margin: 0 0 0.9rem;
      color: var(--fg);
      font-weight: 700;
      letter-spacing: -0.015em;
    }
    .wh-sub { font-family: var(--serif); font-size: 1.2rem; color: var(--fg-dim); max-width: 60ch; margin: 0 0 1.5rem; line-height: 1.45; }
    .wh-stack { list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem 0.9rem; margin: 0 0 1.3rem; padding: 0; }
    .wh-stack li { font-family: var(--mono); font-size: 0.73rem; color: var(--muted); }
    .wh-stack li::before { content: '· '; color: var(--gutter); }
    .wh-stack li:first-child::before { content: ''; }
    .wh-links { display: flex; gap: 1.3rem; font-family: var(--mono); font-size: 0.8rem; }
    .wh-links a { color: var(--pc); }

    /* ─── canonical-source callout ─── */
    .fullsource {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.5rem 1rem;
      max-width: 70ch;
      margin: 0 0 2.5rem;
      padding: 0.9rem 1.1rem;
      background: var(--surface);
      border: 1px solid var(--line);
      border-left: 2px solid var(--pc);
      border-radius: 4px;
    }
    .fullsource .fs-label {
      font-family: var(--mono);
      font-size: 0.68rem;
      letter-spacing: 0.04em;
      color: var(--muted);
      text-transform: uppercase;
    }
    .fullsource a { font-family: var(--mono); font-size: 0.82rem; color: var(--pc); }

    /* ─── long-form document ─── */
    .doc { max-width: 70ch; }

    /* figures: light "paper" cards so charts and screenshots sit intentionally */
    .doc :global(figure) {
      margin: 0 0 1.8rem;
    }
    .doc :global(figure img) {
      display: block;
      width: 100%;
      height: auto;
      background: #f7f6f3;
      border: 1px solid var(--line);
      border-radius: 6px;
      padding: 0.6rem;
    }
    .doc :global(figcaption) {
      margin-top: 0.6rem;
      padding-left: 0.9rem;
      border-left: 2px solid var(--line);
      font-size: 0.86rem;
      line-height: 1.5;
      color: var(--muted);
    }
    .doc :global(h2) {
      font-family: var(--mono);
      font-size: 1.25rem;
      font-weight: 500;
      color: var(--fg);
      margin: 2.8rem 0 1rem;
      padding-top: 0.4rem;
    }
    .doc :global(h3) {
      font-family: var(--mono);
      font-size: 1rem;
      font-weight: 500;
      color: var(--teal);
      margin: 2rem 0 0.8rem;
    }
    .doc :global(p) { margin: 0 0 1.25rem; color: var(--fg-dim); }
    .doc :global(strong) { color: var(--fg); font-weight: 600; }
    .doc :global(em) { color: var(--fg); }
    .doc :global(a) { color: var(--pc); }

    .doc :global(ol), .doc :global(ul) { margin: 0 0 1.4rem; padding-left: 1.4rem; color: var(--fg-dim); }
    .doc :global(li) { margin-bottom: 0.5rem; }
    .doc :global(li)::marker { color: var(--faint); font-family: var(--mono); font-size: 0.85em; }

    .doc :global(code) {
      background: var(--surface-2);
      color: var(--mint);
      padding: 0.1rem 0.35rem;
      border-radius: 3px;
      font-size: 0.84em;
    }
    .doc :global(pre) {
      background: var(--bg-deep);
      border: 1px solid var(--line);
      border-radius: 6px;
      padding: 1rem 1.1rem;
      overflow-x: auto;
      margin: 0 0 1.4rem;
      font-size: 0.82rem;
    }
    .doc :global(pre code) { background: none; color: var(--fg-dim); padding: 0; }

    .doc :global(blockquote) {
      border-left: 2px solid var(--pc);
      margin: 0 0 1.4rem;
      padding: 0.2rem 0 0.2rem 1.2rem;
      color: var(--muted);
      font-style: italic;
    }

    /* tables (the results carry real numbers) */
    .doc :global(table) {
      width: 100%;
      border-collapse: collapse;
      margin: 0 0 1.6rem;
      font-family: var(--mono);
      font-size: 0.8rem;
    }
    .doc :global(thead th) {
      text-align: left;
      color: var(--muted);
      font-weight: 500;
      border-bottom: 1px solid var(--faint);
      padding: 0.5rem 0.8rem 0.5rem 0;
    }
    .doc :global(tbody td) {
      border-bottom: 1px solid var(--line);
      padding: 0.5rem 0.8rem 0.5rem 0;
      color: var(--fg-dim);
    }
    .doc :global(tbody tr:hover td) { background: var(--surface); }
    .doc :global(td strong), .doc :global(th strong) { color: var(--pc); }

    .doc :global(hr) { border: none; border-top: 1px solid var(--line); margin: 2.5rem 0; }

    .wfoot {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      margin-top: 3.5rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--line);
      font-family: var(--mono);
      font-size: 0.8rem;
    }
    .wfoot a { color: var(--muted); }
    .wfoot a:hover { color: var(--mint); text-decoration: none; }

    .statusline { border-top: 1px solid var(--line); background: var(--bg-deep); margin-top: 2rem; }
    .statusline-inner {
      display: flex; align-items: center;
      font-family: var(--mono); font-size: 0.72rem;
      height: 2.4rem; color: var(--muted);
    }
    .st-mode { background: var(--mint); color: var(--bg-deep); font-weight: 700; padding: 0.2rem 0.7rem; margin-right: 0.9rem; letter-spacing: 0.05em; }
    .st-file { color: var(--fg-dim); }
    .st-spacer { flex: 1; }
    .st-git { color: var(--teal); margin-right: 1.1rem; }
    @media (max-width: 620px) { .st-file { display: none; } }
  </style>
</Base>
